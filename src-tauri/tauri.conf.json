{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cartographer",
  "version": "0.7.0",
  "identifier": "app.cartographer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Cartographer",
    "copyright": "MIT License",
    "category": "Utility",
    "shortDescription": "A live map of your Windows PC",
    "longDescription": "Cartographer maps your drives, projects, games, apps and backups, finds things you don't use anymore, archives them safely, and answers questions about your PC with Claude. Everything stays on your PC.",
    "homepage": "https://github.com/JackNathan05/Cartographer",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
